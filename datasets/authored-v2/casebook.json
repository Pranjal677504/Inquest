      "id": "authored-v2-001",
      "title": "Auth release reads the wrong signing-key slot",
      "fault_type": "bad_deploy",
      "root_service": "auth",
      "fix": {
        "action": "rollback",
        "target": "auth"
      },
      "difficulty": "medium",
      "onset": 55,
      "narrative": "Auth a204 changes the signing-key slot from active to retired at minute 55. All instances reject otherwise valid sessions immediately after activation. Cache lookups still succeed and traffic is flat. Roll back auth; the cache flag changed later is unrelated.",
      "distractors": [
        "A cache diagnostics flag at minute 57 changes tracing only, after the first rejected session."
      ],
      "missing_logs": [],
      "probes": [
        {
          "tool": "get_alerts",
          "args": {},
          "contains": "now = t=119",
          "role": "discovery"
        },
        {
          "tool": "get_events",
          "args": {},
          "contains": "e1",
          "role": "discovery"
        },
        {
          "tool": "search_logs",
          "args": {
            "service": "auth"
          },
          "contains": "same token accepted on a203",
          "role": "support"
        },
        {
          "tool": "query_metric",
          "args": {
            "service": "auth",
            "metric": "error_rate"
          },
          "contains": "recent(last 10m)=24.00",
          "role": "support"
        },
        {
          "tool": "search_logs",
          "args": {
            "service": "cache"
          },
          "contains": "hit rate unchanged",
          "role": "counterevidence"
        }
      ]
    },
